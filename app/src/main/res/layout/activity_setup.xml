<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="@string/setup_title" />

        <RadioGroup
            android:id="@+id/type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/type_m3u"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:textColor="@color/text"
                android:text="@string/setup_type_m3u" />

            <RadioButton
                android:id="@+id/type_xtream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:textColor="@color/text"
                android:text="@string/setup_type_xtream" />
        </RadioGroup>

        <EditText
            android:id="@+id/name"
            style="@style/FormField"
            android:layout_marginTop="16dp"
            android:hint="@string/setup_name_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/url"
            style="@style/FormField"
            android:hint="@string/setup_url_hint"
            android:inputType="textUri" />

        <LinearLayout
            android:id="@+id/xtream_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/server"
                style="@style/FormField"
                android:hint="@string/setup_server_hint"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/user"
                style="@style/FormField"
                android:hint="@string/setup_user_hint"
                android:inputType="textNoSuggestions" />

            <EditText
                android:id="@+id/pass"
                style="@style/FormField"
                android:hint="@string/setup_pass_hint"
                android:inputType="textVisiblePassword" />
        </LinearLayout>

        <Button
            android:id="@+id/save"
            style="@style/ListButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:textSize="16sp"
            android:text="@string/setup_save" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
